# EditorConfig 文件

root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
max_line_length = 100
trim_trailing_whitespace = false

[*.json]
indent_size = 2

[*.yml]
indent_size = 2

[*.ts]
indent_size = 2
tslint_integration = true

[*.tsx]
indent_size = 2

[*.js]
indent_size = 2

[*.jsx]
indent_size = 2

[*.css]
indent_size = 2

[*.scss]
indent_size = 2

[*.html]
indent_size = 2

[*.xml]
indent_size = 2

[*.java]
indent_size = 4

[*.py]
indent_size = 4
